{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase-config.example.js",
      "firestore.rules",
      "firestore.indexes.json",
      ".gitignore",
      "**/.*"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "**/*.@(html|js|css|json)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
